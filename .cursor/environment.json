{
  "name": "Wiseman Psychedelics",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ./venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && HOST=0.0.0.0 PORT=3000 BROWSER=none npm start"
    }
  ],
  "ports": [
    { "name": "backend", "port": 8000 },
    { "name": "frontend", "port": 3000 }
  ]
}
